{
  "name": "plotrush",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "content:validate": "python3 docs/implementation/validate_starter_cases.py",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "lint": "eslint .",
    "api:generate": "node --import tsx scripts/generate-openapi.ts",
    "api:check": "node --import tsx scripts/generate-openapi.ts --check",
    "payments:work": "node --import tsx scripts/payment-worker.ts",
    "staff:manage": "node --import tsx scripts/staff.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.15",
    "lucide-react": "1.68.0",
    "next": "16.4.5",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite-socket": "0.2.18",
    "@playwright/test": "1.58.2",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.5",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "type": "module"
}
