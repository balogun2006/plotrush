{
  "openapi": "3.1.0",
  "info": {
    "title": "PlotRush account and commerce foundation",
    "version": "0.2.0",
    "description": "Generated from runtime Zod contracts. Scope: newly implemented account/order routes; gameplay and admin paths remain to be added. Payment simulation is local-only. Paystack test checkout, verification and signed webhook acknowledgement are implemented; live billing remains gated."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "plotrush_guest"
      }
    }
  },
  "paths": {
    "/api/webhooks/paystack": {
      "servers": [
        {
          "url": "/"
        }
      ],
      "post": {
        "description": "Raw-body signed Paystack event. No cookie/Origin required. Timestamped Paystack-Signature preferred; optional explicit legacy x-paystack-signature. Acknowledged after durable inbox insert.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Durably received"
          },
          "401": {
            "description": "Invalid signature"
          },
          "413": {
            "description": "Event too large"
          },
          "503": {
            "description": "Configuration or database unavailable"
          }
        }
      }
    },
    "/account": {
      "get": {
        "responses": {
          "200": {
            "description": "Successful response in the data/meta envelope",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "$schema": "https://json-schema.org/draft/2020-12/schema",
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "guest"
                            }
                          },
                          "required": [
                            "kind"
                          ]
                        },
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "verified"
                            },
                            "email": {
                              "type": "string",
                              "format": "email",
                              "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
                            },
                            "verifiedAt": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "kind",
                            "email",
                            "verifiedAt"
                          ]
                        }
                      ]
                    },
                    "meta": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
