# Local development: DATABASE_URL can be omitted for embedded PostgreSQL.
# Railway preview: DATABASE_URL must reference the private Postgres service.
APP_URL=http://localhost:3000
DATABASE_URL=
PREVIEW_MODE=true
NEXT_TELEMETRY_DISABLED=1
# Independently disabled until configured and tested.
FEATURE_PAYMENTS=false
FEATURE_DIRECT_ADS=false
FEATURE_GOOGLE_ADS=false

# Sandbox Paystack hosted checkout. Never commit real keys.
PAYMENT_PROVIDER=paystack
PAYSTACK_ENVIRONMENT=test
FEATURE_SANDBOX_CATALOGUE=false
FEATURE_PAYMENT_RECEIPTS=false
PAYSTACK_WEBHOOK_SECRET=replace_me
PAYSTACK_WEBHOOK_SECRET_PREVIOUS=
PAYSTACK_ALLOW_LEGACY_WEBHOOKS=false
PAYSTACK_SECRET_KEY=replace_me
# Hosted checkout does not require a public Paystack key.

# Email is disabled on deployed previews until a real key/sender are configured.
FEATURE_EMAIL_AUTH=false
EMAIL_PROVIDER=resend
RESEND_API_KEY=replace_me
EMAIL_FROM=
# Generate a server-only random secret of at least 32 characters for deployed auth.
AUTH_CODE_SECRET=
